{
  "operation": "POST /api/v1/users/{user_id}/password-reset",
  "name": "link",
  "summary": "A one-time link that sets the person's password, shown once",
  "request": {
    "path": {
      "user_id": "00000000-0000-4000-8000-000000000001"
    }
  },
  "response": {
    "status": 201,
    "body": {
      "url": "http://localhost:5173/reset-password?token=example-reset-token",
      "expiresAt": "2026-11-02T12:51:00Z",
      "sentTo": null
    }
  }
}
