{
  "operation": "GET /.well-known/oauth-authorization-server",
  "name": "metadata",
  "summary": "The authorization server's endpoints and what it supports",
  "request": {},
  "response": {
    "status": 200,
    "body": {
      "issuer": "http://localhost:8000",
      "authorization_endpoint": "http://localhost:8000/oauth/authorize",
      "token_endpoint": "http://localhost:8000/oauth/token",
      "revocation_endpoint": "http://localhost:8000/oauth/revoke",
      "jwks_uri": "http://localhost:8000/oauth/jwks",
      "grant_types_supported": [
        "authorization_code",
        "refresh_token",
        "client_credentials"
      ],
      "token_endpoint_auth_methods_supported": [
        "client_secret_basic",
        "client_secret_post",
        "none"
      ],
      "revocation_endpoint_auth_methods_supported": [
        "none"
      ],
      "scopes_supported": [
        "management",
        "consumer",
        "agent"
      ],
      "response_types_supported": [
        "code"
      ],
      "code_challenge_methods_supported": [
        "S256"
      ],
      "registration_endpoint": "http://localhost:8000/oauth/register"
    }
  }
}
