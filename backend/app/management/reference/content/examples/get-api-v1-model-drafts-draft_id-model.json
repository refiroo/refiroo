                "fsoNumber": "fso-number",
                "latitude": "latitude",
                "longitude": "longitude",
                "height": "height",
                "sboid": "operator-sboid"
              },
              "parent": [
                "objectType",
                "id"
              ],
              "path": true,
              "related": {
                "operator": {
                  "via": "stop-operated-by-operator",
                  "fields": {
                    "id": "id",
                    "code": "operator-code",
                    "name": "name",
                    "localName": "relation:local-name",
                    "isPrimary": "relation:is-primary"
                  }
                },
                "modes": {
                  "via": "stop-served-by-mode",
                  "fields": {
                    "id": "id",
                    "code": "mode-code",
                    "name": "name"
                  }
                },
                "systemCodes": {
                  "via": "represented-by-system-code",
                  "fields": {
                    "system": "ancestor:system.name",
                    "systemKey": "ancestor:system.system-key",
                    "code": "external-id",
                    "name": "name"
                  }
                },
                "translations": {
                  "via": "object-has-translation",
                  "fields": {
                    "languageCode": "ancestor:language.language-code",
                    "translatedName": "translated-name",
                    "isActive": "active"
                  }
                }
              }
            },
            "operations": {
              "objects": {},
              "xref": {
                "matchOn": [
                  {
                    "field": "id",
                    "exact": 1000
                  },
                  {
                    "field": "stop-number",
                    "exact": 900
                  }
                ],
                "alsoMatchThrough": [
                  {
                    "related": "systemCodes",
                    "firstOf": [
                      {
                        "field": "external-id",
                        "exact": 90
                      },
                      {
                        "field": "name",
                        "contains": 10
                      }
                    ]
                  },
                  {
                    "related": "translations",
                    "firstOf": [
                      {
                        "field": "translated-name",
                        "exact": 60
                      },
                      {
                        "field": "translated-name",
                        "contains": 12
                      }
                    ]
                  }
                ]
              },
              "resolve": {},
              "lists": {
                "municipalities": {
                  "of": "municipality",
                  "within": {
                    "filter": "district"
                  }
                },
                "stops": {
                  "of": "stop",
                  "within": {
                    "filter": "municipality"
                  },
                  "sortBy": "stop-number"
                },
                "all-stops": {
                  "of": "stop",
                  "sortBy": "stop-number"
                },
                "operators": {
                  "of": "operator"
                },
                "modes": {
                  "of": "mode"
                }
              },
              "events": {
