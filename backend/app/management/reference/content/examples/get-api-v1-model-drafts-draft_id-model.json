                        "name"
                      ]
                    }
                  }
                ]
              }
            },
            "filters": {
              "district": {
                "under": [
                  "district"
                ],
                "matchOn": [
                  "id",
                  "name",
                  "fso-number"
                ]
              },
              "municipality": {
                "under": [
                  "municipality"
                ],
                "matchOn": [
                  "id",
