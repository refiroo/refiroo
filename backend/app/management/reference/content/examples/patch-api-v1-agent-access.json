{
  "operation": "PATCH /api/v1/agent-access",
  "name": "limits",
  "summary": "Set how long an assistant stays signed in",
  "request": {
    "body": {
      "sessionIdleDays": 14,
      "sessionDays": 60,
      "expectedVersion": 1
