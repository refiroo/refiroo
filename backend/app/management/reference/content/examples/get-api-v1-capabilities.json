{
  "operation": "GET /api/v1/capabilities",
  "name": "thisInstance",
  "summary": "What this instance offers the signed-in administrator",
  "request": {},
  "response": {
    "status": 200,
    "body": {
      "modelAdmin": {
        "readReleases": true,
        "manageDrafts": true,
        "install": true,
        "activate": true,
        "setting": "MODEL_ADMIN_MUTATIONS_ENABLED"
      },
      "workspaceAdmin": {
        "manageWorkspaces": true,
        "setting": "WORKSPACE_ADMIN_MUTATIONS_ENABLED"
      },
      "integrationJobs": {
        "createJobs": true,
        "runModes": [
          "inline",
          "background"
        ],
        "limits": {
          "batchMaxItems": 1000,
          "batchMaxBytes": 5242880,
          "atomicJobMaxItems": 10000,
          "backgroundJobMaxItems": 1000000,
          "backgroundBatchMaxBytes": 52428800,
          "chunkItems": 500,
          "importMaxBytes": 209715200,
          "previewMaxItems": 10000,
          "retentionDays": 7
        },
        "setting": "INTEGRATION_JOBS_ENABLED"
      },
      "changeFeed": {
        "retentionDays": 30
      },
      "consumerApi": {
        "resolveMaxItems": 1000,
        "setting": "CONSUMER_RESOLVE_MAX_ITEMS"
      },
      "consumerSubscriptions": {
        "manageSubscriptions": false,
        "logRetentionDays": 7,
        "delivery": {
          "maxEventsPerBatch": 1000,
          "maxBytes": 1048576,
          "timeoutSeconds": 10.0,
          "retryWaitsSeconds": [
            10,
            30
          ],
          "laterWaitSeconds": 3600,
          "retryHours": 24
        },
        "setting": "CONSUMER_SUBSCRIPTIONS_ENABLED"
      }
    }
  },
  "notes": [
    "`consumerSubscriptions.delivery.retryWaitsSeconds`: the first 2 of 7 items are shown."
  ]
}
