.DS_Store
.env
# The reference installation's certificate and key (compose.yml)
/certs/
# The developer instance's settings and certificate (scripts/dev.sh)
.dev/
.idea/
.vscode/
__pycache__/
*.py[cod]
*.db
.pytest_cache/
.ruff_cache/
.venv/
.claude/
.tmp/
.codex/
node_modules/
dist/
build/
coverage/
*.egg-info/
*.tsbuildinfo

# Local source material, never committed: samples, models, documents
/not_to_git/

# The test harness's private PostgreSQL server and its seeded template databases (PG-D8, H1)
backend/.test-postgres
backend/.test-postgres.nosync/
# The development PostgreSQL server's data directory (scripts/postgres.sh); each may be a link to a
# `.nosync` folder, which iCloud leaves alone.
backend/.postgres
backend/.postgres.nosync/

# Export files waiting for download (JOB_FILE_DIR's default, 0.9 J1)
var/job-files/

# Test selection data (pytest-testmon, H4b)
backend/.testmondata*

# Files named for staying out of git, wherever they are
*_not_to_git*

# The public website is its own repository (website/.git), never part of rdm-engine
/website/

# The AI usage log a developer tool appends to (kept locally)
backend/devtools/usage.jsonl
