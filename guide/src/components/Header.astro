---
// The one header (HD): the same bar as the application and the API reference (the shared stylesheet is
// ../../../frontend/public/brand/refiroo-header.css). The logo goes to the application's home; a public site
// build sets PUBLIC_GUIDE_SITE=1 to send it to the guide's home instead (see astro.config.mjs).
import Search from "virtual:starlight/components/Search";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const publicSite = Boolean(import.meta.env.PUBLIC_GUIDE_SITE);
const logoHref = publicSite ? `${base}/` : "/";
---

<div class="rdm-header">
  <a class="rdm-mark" href={logoHref} aria-label="refiroo home">
    <img src={`${base}/refiroo-mascot.png`} alt="" width="32" height="32" />
    <img class="rdm-wordmark" src={`${base}/refiroo-wordmark.png`} alt="refiroo" height="18" />
  </a>
  <nav class="rdm-tabs" aria-label="Documentation">
    <a class="rdm-tab" href={`${base}/`} aria-current="page">
      <span class="rdm-full">Documentation</span><span class="rdm-short">Docs</span>
    </a>
    <a class="rdm-tab" href={`${base}/api/`}>
      <span class="rdm-full">API reference</span><span class="rdm-short">API</span>
    </a>
  </nav>
  <div class="rdm-search sl-flex print:hidden"><Search /></div>
  <div class="rdm-spacer"></div>
  <div class="sl-hidden md:sl-flex print:hidden rdm-right"><ThemeSelect /></div>
</div>
