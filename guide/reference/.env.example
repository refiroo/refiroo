# The guide's reference instance (guide/reference/reference.sh). reference.sh makes .env from this
# file and fills the generated values in; .env is git-ignored. Throwaway secrets, for a local instance.
# Never run anything but local data on it.
PUBLIC_URL=http://localhost:8480
POSTGRES_PASSWORD=@generated
SECRETS_ENCRYPTION_KEY=@generated
RDM_CURSOR_SIGNING_KEY=@generated
# Plain HTTP on this host; 8443 is reserved for the project and unused.
WEB_TLS=proxy
WEB_HTTP_PORT=8480
WEB_HTTPS_PORT=8443
WEB_CERTS_DIR=./guide/reference/certs
# The model is installed through the API, which is off by default.
MODEL_ADMIN_MUTATIONS_ENABLED=true
# Sign-in of the local administrator (guide/samples/load.py reads these; the engine ignores them).
GUIDE_ADMIN_USERNAME=guide
GUIDE_ADMIN_PASSWORD=@generated
