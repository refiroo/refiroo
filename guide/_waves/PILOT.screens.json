    {
      "name": "names-matrix",
      "shows": "The Names application, Municipality names: municipalities by language (English, French, German, Italian, Romansh) with the cell states One, Several, Inactive, History only, None, Conflict explained above the table.",
      "actions": [{ "goto": "/apps/names/views/municipality-names?workspaceKey=graubuenden" }, { "waitFor": { "text": "Albula/Alvra", "exact": true } }, { "wait": 1200 }],
