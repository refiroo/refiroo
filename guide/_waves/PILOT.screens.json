            "name": "Changes in this change set"
          }
        },
        {
          "click": {
            "role": "button",
            "name": "See the data with these changes"
          }
        },
        {
          "waitFor": {
            "role": "button",
            "name": "Review changes"
          }
        },
        {
          "wait": 1200
        }
      ],
      "expect": [
        "Change set",
        "December 2026 timetable change",
        "Review changes",
        "Publish"
      ]
    },
    {
      "name": "change-set-review",
      "shows": "What a change set opens on: Changes in this change set, the list of changed records (stops with a changed Valid to), with the tabs Records and Relationships and the Publish button and ⋯ menu in the banner.",
      "actions": [
        {
          "goto": "/apps/network/change-sets?workspaceKey=graubuenden"
        },
        {
          "click": {
            "role": "button",
            "name": "Open change set"
          }
        },
        {
          "waitFor": {
            "role": "heading",
            "name": "Changes in this change set"
          }
        },
        {
          "wait": 1500
        }
