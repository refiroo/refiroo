{
  "wave": "PILOT",
  "note": "Real screens of the reference instance (guide/reference, http://localhost:8480), light theme, 1440 px wide. Taken by guide/tools/screens.mjs and written to guide/public/screens/<name>.png, which the pages reference as /guide/screens/<name>.png. 'shows' says what the picture is for; 'expect' lists texts that must be visible or the capture is reported as failed.",
  "base": "http://localhost:8480",
  "screens": [
    {
      "name": "home",
      "shows": "Home, where a steward lands after signing in: the workspace Graubünden with its applications Network, Systems, Names, and the open change set.",
      "actions": [{ "goto": "/" }, { "waitFor": { "text": "Your change sets", "exact": true } }],
      "expect": ["Your workspaces", "Graubünden", "Network", "December 2026 timetable change"]
    },
    {
      "name": "stops-search-chur",
      "shows": "The Stops list of the Network application with the search box holding Chur.",
      "actions": [
        { "goto": "/apps/network/views/stops?workspaceKey=graubuenden" },
        { "fill": { "css": "input[aria-label=Search]" }, "value": "Chur" },
        { "wait": 1800 }
      ],
      "expect": ["Stops", "Chur Wiesental", "Chur Altstadt"]
    },
    {
      "name": "stops-filter-menu",
      "shows": "The same search with the Filter menu open, listing the fields and relationships a list can be filtered by.",
      "actions": [
        {"goto": "/apps/network/views/stops?workspaceKey=graubuenden"},
        {"fill": {"css": "input[aria-label=Search]"}, "value": "Chur"},
        {"wait": 1500},
        {"click": {"role": "button", "name": "Filter", "exact": true}},
        {"wait": 900}
      ],
      "expect": ["Fields", "Relationships", "Operated by", "Valid from"]
    },
    {
      "name": "stops-filtered-sorted",
      "shows": "Search Chur, filtered to stops operated by Rhätische Bahn, sorted by Valid from, newest first: eight stops including Chur Wiesental.",
      "actions": [
        { "goto": "/apps/network/views/stops?workspaceKey=graubuenden" },
        { "fill": { "css": "input[aria-label=Search]" }, "value": "Chur" },
        { "wait": 1500 },
        { "click": { "role": "button", "name": "Filter", "exact": true } },
        { "click": { "text": "Operated by", "exact": true, "nth": -1 } },
        { "fill": { "placeholder": "Search operators" }, "value": "Rhätische" },
        { "wait": 800 },
        { "click": { "text": "Rhätische Bahn", "exact": true, "in": { "role": "dialog" } } },
        { "click": { "role": "button", "name": "Apply", "in": { "role": "dialog" } } },
        { "wait": 1200 },
        { "click": { "role": "button", "name": "Sort:" } },
        { "click": { "role": "menuitemradio", "name": "Valid from" } },
        { "click": { "role": "button", "name": "Sort:" } },
        { "click": { "role": "menuitemradio", "name": "Descending" } },
        { "wait": 1200 }
      ],
      "expect": ["Operated by", "Chur West", "Chur Wiesental", "8 records"]
    },
    {
      "name": "stop-details",
      "shows": "A stop's page: Chur Wiesental, the 'Stop details' fields at the right, and its relationships (Modes, Operator) in the middle.",
      "actions": [
        { "goto": "/apps/network/views/stops?workspaceKey=graubuenden&search=Chur+Wiesental" },
        { "click": { "text": "Chur Wiesental", "exact": true } },
        { "waitFor": { "role": "heading", "name": "Chur Wiesental" } },
        { "wait": 1200 }
      ],
      "expect": ["Stop details", "8509006", "Modes", "Train", "Operator", "Rhätische Bahn", "CHWI"]
    },
    {
      "name": "stop-relationships",
      "shows": "The lower part of Chur Wiesental's full page (Expand to full page): System codes (two codes from other systems) and Name translations (none yet), each with its own Add button.",
      "actions": [
        {"goto": "/apps/network/views/stops?workspaceKey=graubuenden&search=Chur+Wiesental"},
        {"click": {"text": "Chur Wiesental", "exact": true}},
        {"waitFor": {"role": "heading", "name": "Chur Wiesental"}},
        {"wait": 1000},
        {"click": {"role": "button", "name": "Expand to full page"}},
        {"waitFor": {"role": "button", "name": "Add Name translation"}},
        {"scrollTo": {"text": "System codes", "exact": true}, "offset": 150}
      ],
      "expect": ["System codes", "Wikidata: stations", "Name translations", "No relationships yet"]
    },
    {
      "name": "stop-edit-field",
      "shows": "Chur Wiesental with one field open for correction in place: Stop number (UIC), saved with Enter and left with Escape (no Save or Cancel buttons).",
      "actions": [
        { "goto": "/apps/network/views/stops?workspaceKey=graubuenden&search=Chur+Wiesental" },
        { "click": { "text": "Chur Wiesental", "exact": true } },
        { "waitFor": { "role": "heading", "name": "Chur Wiesental" } },
        { "wait": 1000 },
        { "click": { "role": "button", "name": "Edit Stop number (UIC): 8509006" } }
      ],
      "expect": ["Stop number (UIC)"]
    },
    {
      "name": "stop-edit-record",
      "shows": "The side sheet for editing Chur Wiesental (record menu, Edit record): the Chur parent with Change, the required fields Name, Designation and Stop number (UIC), More fields opened, and Cancel and Save.",
      "actions": [
        {"goto": "/apps/network/views/stops?workspaceKey=graubuenden&search=Chur+Wiesental"},
        {"click": {"text": "Chur Wiesental", "exact": true}},
        {"waitFor": {"role": "heading", "name": "Chur Wiesental"}},
        {"wait": 1000},
        {"click": {"role": "button", "name": "Record actions"}},
        {"click": {"role": "menuitem", "name": "Edit record"}},
        {"waitFor": {"role": "button", "name": "Save", "exact": true}},
        {"wait": 600}
      ],
      "expect": ["Chur Wiesental", "Change", "Name", "Designation", "Stop number (UIC)", "More fields", "Save"],
      "after": [
        {"click": {"role": "button", "name": "Cancel"}}
      ]
    },
    {
      "name": "save-conflict",
      "height": 1100,
      "shows": "A save refused because someone else changed the stop first. The stop Chur Depot Sand: another session changed its Designation, then this session saved the Abbreviation. The field shows 'Current saved value', 'Your input is preserved' and the message 'The value was not saved: Object version has changed' (the field stays open; Enter tries again, Escape leaves it).",
      "actions": [
        { "goto": "/apps/network/views/stops?workspaceKey=graubuenden&search=Chur+Depot+Sand" },
        { "click": { "text": "Chur Depot Sand", "exact": true } },
        { "waitFor": { "role": "heading", "name": "Chur Depot Sand" } },
        { "goto": "/apps/network/views/stops?workspaceKey=graubuenden&search=Chur+Depot+Sand", "session": "b" },
        { "click": { "text": "Chur Depot Sand", "exact": true }, "session": "b" },
        { "waitFor": { "role": "heading", "name": "Chur Depot Sand" }, "session": "b" },
        { "wait": 1000, "session": "b" },
        { "click": { "role": "button", "name": "Edit Designation: Chur Depot Sand" }, "session": "b" },
        { "focusedFill": "Chur Depot Sand (changed by someone else)", "session": "b" },
        { "press": "Enter", "session": "b" },
        { "wait": 1500, "session": "b" },
        { "click": { "role": "button", "name": "Edit Abbreviation: DEPS" } },
        { "focusedFill": "CHSX" },
        { "press": "Enter" },
        { "waitFor": { "text": "The value was not saved", "exact": false } },
        { "wait": 300 }
      ],
      "after": [
        { "click": { "role": "button", "name": "Edit Designation: Chur Depot Sand (changed by someone else)" }, "session": "b" },
        { "focusedFill": "Chur Depot Sand", "session": "b" },
        { "press": "Enter", "session": "b" },
        { "wait": 1500, "session": "b" }
      ],
      "expect": ["The value was not saved", "Object version has changed", "Your input is preserved"]
    },
    {
      "name": "stop-history",
      "shows": "The History section at the bottom of Chur Wiesental's full page (Expand to full page): who changed what and when, with the filters All, Values, Relationships, Moves.",
      "actions": [
        {"goto": "/apps/network/views/stops?workspaceKey=graubuenden&search=Chur+Wiesental"},
        {"click": {"text": "Chur Wiesental", "exact": true}},
        {"waitFor": {"role": "heading", "name": "Chur Wiesental"}},
        {"wait": 1000},
        {"click": {"role": "button", "name": "Expand to full page"}},
        {"waitFor": {"role": "heading", "name": "History"}},
        {"wait": 800},
        {"scrollTo": {"role": "heading", "name": "History"}, "offset": 90}
      ],
      "expect": ["History", "Values", "Relationships", "Moves", "Guide Admin"]
    },
    {
      "name": "change-sets-list",
      "shows": "The Change sets page of the Network application with the open change set 'December 2026 timetable change' and the button 'New change set'.",
      "actions": [
        {"goto": "/apps/network/change-sets?workspaceKey=graubuenden"},
        {"waitFor": {"text": "December 2026 timetable change", "exact": true}}
      ],
      "expect": ["Change sets", "New change set", "December 2026 timetable change", "Open change set"]
    },
    {
      "name": "change-set-open",
      "shows": "The open change set seen as data: the orange Change set banner with its name, the count of changes, Details, Review changes, Publish and the ⋯ menu above the Stops list (opened with 'See the data with these changes').",
      "actions": [
