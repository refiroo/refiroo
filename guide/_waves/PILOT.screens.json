    {
      "name": "change-set-publish-confirm",
      "shows": "The change set after Validate now (badge 'Change set validation passed') and the 'Publish this change set?' confirmation. Nothing is published.",
      "actions": [
        {
          "goto": "/apps/network/change-sets?workspaceKey=graubuenden"
        },
        {
          "click": {
            "role": "button",
            "name": "Open change set"
          }
        },
        {
          "waitFor": {
            "role": "heading",
            "name": "Changes in this change set"
          }
        },
        {
          "click": {
            "role": "button",
            "name": "More change set actions"
          }
