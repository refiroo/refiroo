{
 "note": "Pictures of the reference instance (guide/reference) that were still drawn in earlier looks, retaken in the current one (OLD54). Taken by guide/tools/screens.mjs --file OLD54.screens.json into guide/public/screens/<name>.png (--scheme dark for a -dark twin where one exists). Order: old54-draft-setup, old54-groups-setup, old54-platform-setup, the model editor pictures, then old54-draft-delete; the other pictures need no draft. The editor pictures read the model draft 'Guide draft' ({draft:Guide draft}, made by old54-draft-setup). Dialogs are cancelled; nothing is installed, activated or published. A state that changes the instance is undone in the screen's 'after'.",
 "screens": [
  {
   "name": "old54-draft-setup",
   "setup": true,
   "shows": "Makes the draft the OLD54 editor pictures read: Settings, Model, New draft named 'Guide draft' on the active release.",
   "actions": [
    {
     "goto": "/settings/model"
    },
    {
     "click": {
      "role": "button",
      "name": "New draft"
     }
    },
    {
     "waitFor": {
      "role": "dialog"
     }
    },
    {
     "fill": {
      "label": "Draft name",
      "in": {
       "role": "dialog"
      }
     },
     "value": "Guide draft"
    },
    {
     "wait": 400
    },
    {
     "click": {
      "role": "button",
      "name": "Create draft"
     }
    },
    {
     "waitFor": {
      "text": "Saved as you go",
      "exact": false
     }
    },
    {
     "wait": 800
    }
   ]
  },
  {
   "name": "old54-groups-setup",
   "setup": true,
   "shows": "Makes a navigation group 'Translations' in Names holding the Language collection and the Municipality names relation matrix.",
   "actions": [
    {
     "goto": "/settings/model/drafts/{draft:Guide draft}/editor?show=application&key=names"
    },
    {
     "waitFor": {
      "text": "Saved as you go",
      "exact": false
     }
    },
    {
     "wait": 1200
    },
    {
     "click": {
      "css": "button[aria-label='Operations for Names']"
     }
    },
    {
     "click": {
      "role": "menuitem",
      "name": "Add a navigation group…"
     }
    },
    {
     "fill": {
      "css": "input"
     },
     "value": "Translations"
    },
    {
     "click": {
      "role": "button",
      "name": "Add group",
      "exact": true
     }
    },
    {
     "wait": 800
    },
    {
     "click": {
      "text": "Translations",
      "exact": true
     }
    },
    {
     "click": {
      "role": "button",
      "name": "Add to group…"
     }
    },
    {
     "click": {
      "label": "Municipality names"
     }
    },
    {
     "click": {
      "label": "Language"
     }
    },
    {
     "click": {
      "role": "button",
      "name": "Apply",
      "exact": true
     }
    },
    {
     "wait": 800
    }
   ]
  },
