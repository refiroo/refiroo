    {
      "name": "find_records",
      "description": "Records of one type matching criteria over their fields, ancestors and one relation hop. Live data, or with changeSetId that change set's. Pass nextCursor back as cursor to read on.",
      "inputSchema": {
        "$defs": {
          "QueryCriterion": {
            "additionalProperties": false,
            "description": "``field``, ``op`` and ``value`` as on the object list, or a ``related`` hop.\n\n``not`` inverts a hop: records with no related record matching its criteria.",
            "properties": {
              "field": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Field"
              },
              "op": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Op"
              },
              "value": {
                "default": null,
                "title": "Value"
              },
              "related": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/RelatedCriterion"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "not": {
                "default": false,
                "title": "Not",
                "type": "boolean"
              }
            },
            "title": "QueryCriterion",
            "type": "object"
          },
          "QueryExpansion": {
            "additionalProperties": false,
            "description": "Records at the other end of a binding, added to each item.",
            "properties": {
              "relationTypeKey": {
                "title": "Relationtypekey",
                "type": "string"
              },
              "direction": {
                "enum": [
                  "outgoing",
                  "incoming"
                ],
                "title": "Direction",
                "type": "string"
              },
              "select": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Fields of each expanded record; omitted, the list's item shape",
                "title": "Select"
              },
              "limit": {
                "default": 20,
                "maximum": 20,
                "minimum": 1,
                "title": "Limit",
                "type": "integer"
              }
            },
            "required": [
              "relationTypeKey",
              "direction"
            ],
            "title": "QueryExpansion",
            "type": "object"
          },
          "RelatedCriterion": {
            "additionalProperties": false,
            "description": "One relation hop: records at the other end of a binding the queried type has.",
            "properties": {
              "relationTypeKey": {
                "title": "Relationtypekey",
                "type": "string"
              },
              "direction": {
                "enum": [
                  "outgoing",
                  "incoming"
                ],
                "title": "Direction",
                "type": "string"
              },
              "where": {
                "description": "Criteria on the record at the other end, combined with AND; no further hop",
                "items": {
                  "$ref": "#/$defs/QueryCriterion"
                },
                "title": "Where",
                "type": "array"
              }
            },
            "required": [
              "relationTypeKey",
              "direction"
            ],
            "title": "RelatedCriterion",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "A query over one object type's records (INTEGRATION_API §Q3).",
        "properties": {
          "workspace": {
            "type": "string"
          },
          "changeSetId": {
            "type": "string",
            "description": "Read a change set this connection created, with its unpublished rows, instead of live data"
          },
          "objectTypeKey": {
            "title": "Objecttypekey",
            "type": "string"
          },
          "asOf": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "A date (YYYY-MM-DD): only records effective on it, by the type's declared effective period; as_of_not_supported on a type without one",
            "title": "Asof"
          },
          "where": {
            "items": {
              "$ref": "#/$defs/QueryCriterion"
            },
            "title": "Where",
            "type": "array"
          },
          "sort": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "One field as on the object list, prefix '-' for descending; name when omitted",
            "title": "Sort"
          },
          "select": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Fields each item returns; omitted, the list's item shape",
            "title": "Select"
          },
          "expand": {
            "items": {
              "$ref": "#/$defs/QueryExpansion"
            },
            "title": "Expand",
            "type": "array"
          },
          "pageSize": {
            "default": 100,
            "maximum": 500,
            "minimum": 1,
            "title": "Pagesize",
            "type": "integer"
          },
          "cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cursor"
          }
        },
        "required": [
          "workspace",
          "objectTypeKey"
        ],
        "title": "ModelQuery",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
