          },
          "applicationKey": {
            "type": "string"
          },
          "objectTypeKey": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "parentObjectId": {
            "type": "string"
          },
          "attributes": {
            "description": "Values by attribute key, as an object or a list of {attributeTypeKey, value}. A value is never null.",
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": {
                  "not": {
                    "type": "null"
                  }
                }
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "attributeTypeKey": {
                      "type": "string"
                    },
                    "value": {
                      "not": {
                        "type": "null"
                      }
                    }
                  },
                  "required": [
                    "attributeTypeKey",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            ]
          }
        },
        "required": [
