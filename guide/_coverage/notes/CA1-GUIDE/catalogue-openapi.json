{
  "openapi": "3.1.0",
  "info": {
    "title": "Catalogue API",
    "version": "1",
    "description": "Consumer API `catalog`, contract version 1, declared by the model release Catalogue 1.0.0. A read takes the live data of a workspace (`workspace`, default: the deployment's default workspace) or one of its publications (`publication`: an ID or `latest`). Every `GET` answers an `ETag` and `304 Not Modified` to a matching `If-None-Match`."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/consumer/catalog/v1/objects/{id}": {
      "get": {
        "summary": "Get by ID",
        "description": "The shared object of the record with this object ID. The definition's parameters filter it (`404 OBJECT_NOT_FOUND` when filtered out) and limit its projections.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "workspace",
            "in": "query",
            "description": "The workspace read (default: the deployment's default workspace); named in `RDM-Workspace`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "publication",
            "in": "query",
            "description": "Read a publication of the workspace instead of live data: its ID, or `latest` for the current one. Read with the definition of the model release it was published under, which must declare this contract version (`409 PUBLICATION_CONTRACT_MISMATCH`). Named in `RDM-Publication`; a cursor keeps its publication.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include",
            "in": "query",
            "description": "Related blocks served on request: `codes`, `parent.codes`. A block is in the answer only when the read names it here; a filter on it narrows the records either way. An unknown name is `400 UNKNOWN_INCLUDE`. Repeated or comma-separated.",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "codes",
                  "parent.codes"
                ]
              }
            }
          },
          {
            "name": "categoryCode",
            "in": "query",
            "description": "Limits `parent.codes` to the items matching a value, and keeps only the records left with one. Several values, repeated or comma-separated (a comma inside a value as `%2C`), are alternatives; text matches ignoring case.",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The answer.",
            "headers": {
              "RDM-Workspace": {
                "$ref": "#/components/headers/RDM-Workspace"
              },
              "RDM-Publication": {
                "$ref": "#/components/headers/RDM-Publication"
              },
              "RDM-As-Of-Applied": {
                "$ref": "#/components/headers/RDM-As-Of-Applied"
              },
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "400": {
            "description": "A request error: UNKNOWN_INCLUDE, UNKNOWN_PARAMETER, PARAMETER_NOT_SUPPORTED, UNKNOWN_OBJECT_TYPE, MULTIPLE_TARGETS, the paging codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Not found: OBJECT_NOT_FOUND, WORKSPACE_NOT_FOUND, PUBLICATION_NOT_FOUND, TARGET_NOT_FOUND, CONSUMER_API_NOT_FOUND, CONTRACT_VERSION_NOT_FOUND.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflict: AMBIGUOUS_TARGET, PUBLICATION_CONTRACT_MISMATCH.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/consumer/catalog/v1/lists/items": {
      "get": {
        "summary": "List items",
        "description": "Every Item record, ordered by name, then creation order (in a publication, object ID). Paged with cursors both ways, `position`, `from=end`, `seek` and `includeTotal`; `pageSize` 1\u2013100, default 20.",
        "parameters": [
          {
            "name": "workspace",
            "in": "query",
            "description": "The workspace read (default: the deployment's default workspace); named in `RDM-Workspace`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "publication",
            "in": "query",
            "description": "Read a publication of the workspace instead of live data: its ID, or `latest` for the current one. Read with the definition of the model release it was published under, which must declare this contract version (`409 PUBLICATION_CONTRACT_MISMATCH`). Named in `RDM-Publication`; a cursor keeps its publication.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include",
            "in": "query",
            "description": "Related blocks served on request: `codes`, `parent.codes`. A block is in the answer only when the read names it here; a filter on it narrows the records either way. An unknown name is `400 UNKNOWN_INCLUDE`. Repeated or comma-separated.",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "codes",
                  "parent.codes"
                ]
              }
            }
          },
          {
            "name": "categoryCode",
            "in": "query",
            "description": "Limits `parent.codes` to the items matching a value, and keeps only the records left with one. Several values, repeated or comma-separated (a comma inside a value as `%2C`), are alternatives; text matches ignoring case.",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "`nextCursor`, `prevCursor` or `anchor` of a page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "position",
            "in": "query",
            "description": "Start at this position (from 0).",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "`end`: the last page.",
            "schema": {
              "type": "string",
              "enum": [
                "start",
                "end"
              ]
            }
          },
          {
            "name": "seek",
            "in": "query",
            "description": "Start at this sort value.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "includeTotal",
            "in": "query",
            "description": "Count `totalCount` and `startIndex`.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The answer.",
            "headers": {
              "RDM-Workspace": {
                "$ref": "#/components/headers/RDM-Workspace"
              },
              "RDM-Publication": {
                "$ref": "#/components/headers/RDM-Publication"
              },
              "RDM-As-Of-Applied": {
                "$ref": "#/components/headers/RDM-As-Of-Applied"
              },
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListPage"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "400": {
            "description": "A request error: UNKNOWN_INCLUDE, UNKNOWN_PARAMETER, PARAMETER_NOT_SUPPORTED, UNKNOWN_OBJECT_TYPE, MULTIPLE_TARGETS, the paging codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Not found: LIST_NOT_FOUND, PARENT_NOT_FOUND, WORKSPACE_NOT_FOUND, PUBLICATION_NOT_FOUND, CONSUMER_API_NOT_FOUND, CONTRACT_VERSION_NOT_FOUND.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflict: PUBLICATION_CONTRACT_MISMATCH.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/consumer/catalog/v1/xref": {
      "get": {
        "summary": "XREF lookup",
        "description": "The exposed records the query's terms match, scored by the definition's match rules, best first (score, public type name, name, object ID); with `expect=one`, the single best one. Matching part of a value (contains) needs a term of at least 3 characters; a shorter term matches whole values only. A query whose terms match more than 10,000 records is refused as `400 QUERY_TOO_BROAD`, whatever parameters narrow it. A query holds at most 100 terms. The definition's parameters narrow the scored records without changing their scores.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "The terms: repeated or comma-separated (a comma inside a term as `%2C`).",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "expect",
            "in": "query",
            "description": "`one`: the single best record, `404 NO_MATCH` or `409 AMBIGUOUS_MATCH`.",
            "schema": {
              "type": "string",
              "enum": [
                "any",
                "one"
              ],
              "default": "any"
            }
          },
          {
            "name": "workspace",
            "in": "query",
            "description": "The workspace read (default: the deployment's default workspace); named in `RDM-Workspace`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "publication",
            "in": "query",
            "description": "Read a publication of the workspace instead of live data: its ID, or `latest` for the current one. Read with the definition of the model release it was published under, which must declare this contract version (`409 PUBLICATION_CONTRACT_MISMATCH`). Named in `RDM-Publication`; a cursor keeps its publication.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include",
            "in": "query",
            "description": "Related blocks served on request: `codes`, `parent.codes`. A block is in the answer only when the read names it here; a filter on it narrows the records either way. An unknown name is `400 UNKNOWN_INCLUDE`. Repeated or comma-separated.",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "codes",
                  "parent.codes"
                ]
              }
            }
          },
          {
            "name": "categoryCode",
            "in": "query",
            "description": "Limits `parent.codes` to the items matching a value, and keeps only the records left with one. Several values, repeated or comma-separated (a comma inside a value as `%2C`), are alternatives; text matches ignoring case.",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "`nextCursor`, `prevCursor` or `anchor` of a page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "position",
            "in": "query",
            "description": "Start at this position (from 0).",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "`end`: the last page.",
            "schema": {
              "type": "string",
              "enum": [
                "start",
                "end"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The answer.",
            "headers": {
              "RDM-Workspace": {
                "$ref": "#/components/headers/RDM-Workspace"
              },
              "RDM-Publication": {
                "$ref": "#/components/headers/RDM-Publication"
              },
              "RDM-As-Of-Applied": {
                "$ref": "#/components/headers/RDM-As-Of-Applied"
              },
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/XrefPage"
                    },
                    {
                      "$ref": "#/components/schemas/ScoredObject"
                    }
                  ]
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "400": {
            "description": "A request error: QUERY_REQUIRED, TOO_MANY_TERMS, QUERY_TOO_BROAD, INVALID_EXPECT, UNKNOWN_INCLUDE, UNKNOWN_PARAMETER, PARAMETER_NOT_SUPPORTED, UNKNOWN_OBJECT_TYPE, MULTIPLE_TARGETS, the paging codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Not found: NO_MATCH, TARGET_NOT_FOUND, WORKSPACE_NOT_FOUND, PUBLICATION_NOT_FOUND, CONSUMER_API_NOT_FOUND, CONTRACT_VERSION_NOT_FOUND.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflict: AMBIGUOUS_MATCH, AMBIGUOUS_TARGET, PUBLICATION_CONTRACT_MISMATCH.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/consumer/catalog/v1/resolve": {
      "post": {
        "summary": "Batch resolve",
        "description": "Up to 1000 lookups in one read, each answered as the single read it stands for: by `query` as XREF with `expect=one`, by `id` as get by ID. Outcomes come in item order. Answers no `ETag`.",
        "parameters": [
          {
            "name": "workspace",
            "in": "query",
            "description": "The workspace read (default: the deployment's default workspace); named in `RDM-Workspace`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "publication",
            "in": "query",
            "description": "Read a publication of the workspace instead of live data: its ID, or `latest` for the current one. Read with the definition of the model release it was published under, which must declare this contract version (`409 PUBLICATION_CONTRACT_MISMATCH`). Named in `RDM-Publication`; a cursor keeps its publication.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The answer.",
            "headers": {
              "RDM-Workspace": {
                "$ref": "#/components/headers/RDM-Workspace"
              },
              "RDM-Publication": {
                "$ref": "#/components/headers/RDM-Publication"
              },
              "RDM-As-Of-Applied": {
                "$ref": "#/components/headers/RDM-As-Of-Applied"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResolveAnswer"
                }
              }
            }
          },
          "400": {
            "description": "A request error: REQUEST_VALIDATION_ERROR, UNKNOWN_INCLUDE, UNKNOWN_PARAMETER, PARAMETER_NOT_SUPPORTED, UNKNOWN_OBJECT_TYPE, MULTIPLE_TARGETS, the paging codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Not found: WORKSPACE_NOT_FOUND, PUBLICATION_NOT_FOUND, CONSUMER_API_NOT_FOUND, CONTRACT_VERSION_NOT_FOUND.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflict: PUBLICATION_CONTRACT_MISMATCH.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "More than 1000 items: `BATCH_TOO_LARGE`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/consumer/catalog/v1/publications": {
      "get": {
        "summary": "Publications",
        "description": "The workspace's publications, newest first. `eventSequence` is the feed position of the publication's `published` entry: live data at that position equals the publication.",
        "parameters": [
          {
            "name": "workspace",
            "in": "query",
            "description": "The workspace read (default: the deployment's default workspace); named in `RDM-Workspace`.",
            "schema": {
