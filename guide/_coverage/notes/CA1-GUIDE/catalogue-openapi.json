            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "`nextCursor`, `prevCursor` or `anchor` of a page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "position",
            "in": "query",
            "description": "Start at this position (from 0).",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "`end`: the last page.",
            "schema": {
              "type": "string",
              "enum": [
                "start",
                "end"
              ]
            }
          },
          {
            "name": "includeTotal",
            "in": "query",
            "description": "Count `totalCount` and `startIndex`.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The answer.",
            "headers": {
              "RDM-Workspace": {
                "$ref": "#/components/headers/RDM-Workspace"
              },
              "RDM-Publication": {
                "$ref": "#/components/headers/RDM-Publication"
              },
              "RDM-As-Of-Applied": {
                "$ref": "#/components/headers/RDM-As-Of-Applied"
              },
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicationPage"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "400": {
            "description": "A request error: UNKNOWN_PARAMETER, PARAMETER_NOT_SUPPORTED, UNKNOWN_OBJECT_TYPE, MULTIPLE_TARGETS, the paging codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Not found: WORKSPACE_NOT_FOUND, CONSUMER_API_NOT_FOUND, CONTRACT_VERSION_NOT_FOUND.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
