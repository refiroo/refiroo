  "consumerApis": [
    {
      "key": "rdm",
      "name": "RDM API",
      "description": "The master data: domains, their codelists and the codelists' values, with the systems' codes mapped to each value and its translations. Lists read each level under its parent. XREF and batch resolve look a record up by its ID, master ID, code or name, or by a mapped system code or a translated name. The values-changed event reports values created, changed or deleted.",
      "contractVersion": 1,
      "exposes": ["domain", "codelist", "master-value"],
      "publicNames": { "master-value": "CodelistValue" },
      "object": {
        "fields": {
          "id": { "role": "id" },
          "code": { "role": "code", "from": ["value-code", "codelist-code", "domain-code"] },
          "name": { "role": "name", "from": "name" },
          "isActive": { "role": "active", "from": "active", "default": true },
          "validFrom": { "role": "validFrom", "from": "valid-from" },
          "validTo": { "role": "validTo", "from": "valid-to" },
          "description": "description",
          "masterId": "master-id",
          "valueName": "value-name",
          "sortOrder": "sort-order"
        },
        "parent": ["objectType", "id", "code", "name"],
        "path": true,
        "related": {
          "systemVariants": {
            "via": "master-value-represented-by-system-value",
            "fields": {
              "system": "ancestor:system.name",
              "systemCode": "ancestor:system.system-code",
              "value": "name",
              "valueCode": "value-code",
              "valueName": "value-name",
              "externalId": "external-id",
              "isActive": "active"
            }
          },
          "translations": {
            "via": "object-has-translation",
            "fields": {
              "languageCode": "ancestor:language.language-code",
              "languageName": "ancestor:language.name",
              "translatedName": "translated-name",
              "translatedValue": "translated-value",
              "isActive": "active"
            }
          }
        }
      },
      "operations": {
        "objects": {},
        "xref": {
          "matchOn": [
            { "field": "id", "exact": 1000 },
            { "field": "master-id", "exact": 900 },
            { "field": "code", "exact": 500, "contains": 40 },
            { "field": "name", "exact": 200, "contains": 30 },
            { "field": "value-name", "exact": 200, "contains": 30 }
          ],
          "alsoMatchThrough": [
            {
              "related": "systemVariants",
              "firstOf": [
                { "field": "external-id", "exact": 90 },
                { "field": "value-code", "exact": 80 },
                { "field": "name", "exact": 75 },
                { "field": "value-name", "exact": 75 },
                { "field": "value-code", "contains": 10 },
                { "field": "name", "contains": 10 }
              ]
            },
            {
              "related": "translations",
              "firstOf": [
                { "field": "translated-name", "exact": 60 },
                { "field": "translated-name", "contains": 12 }
              ]
            }
          ]
        },
        "resolve": {},
        "lists": {
          "domains": { "of": "domain" },
          "codelists": { "of": "codelist", "within": { "filter": "domain" } },
          "values": { "of": "master-value", "within": { "filter": "codelist" }, "sortBy": "sort-order" }
        },
        "events": {
          "custom": [
            {
              "key": "values-changed",
              "objectTypes": ["master-value"],
              "changes": ["created", "updated", "deleted"],
              "watch": { "fields": ["code", "name", "isActive", "validFrom", "validTo"] }
            }
          ]
        }
      },
      "filters": { "domain": { "under": ["domain"] }, "codelist": { "under": ["codelist"] } }
    }
  ]
}
