# Required: a PostgreSQL database with the ICU root collation (PG-D11). The development server
# (scripts/postgres.sh start) prints this URL; Docker Compose sets its own.
DATABASE_URL=postgresql+psycopg://postgres@localhost:54320/rdm
RDM_MODEL_PATH=../model/rdm-starter.json
# Set a stable key to keep pagination cursors valid across restarts
# RDM_CURSOR_SIGNING_KEY=
# Model administration mutations require WEB_CONCURRENCY=1
# MODEL_ADMIN_MUTATIONS_ENABLED=false
# Workspace administration is pre-authentication and enabled by default; disable it on exposed APIs
# WORKSPACE_ADMIN_MUTATIONS_ENABLED=false
VITE_API_URL=http://localhost:8000
