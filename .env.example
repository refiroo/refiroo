# The reference installation's settings (compose.yml, 0.12 DP2). Copy this file to .env, fill it in
# and keep .env beside your backups: it holds the keys that open what the database stores. Never
# commit it, and never put a value in an image. A developer instance uses scripts/dev.sh instead.

# The address people open, with no path and no trailing slash. It is the issuer of the engine's
# tokens, the address a sign-in provider returns to and the host passkeys are bound to; changing its
# host later signs everyone out and ends their passkeys.
PUBLIC_URL=https://rdm.example.org

# The database's password, chosen once: the database is created with it. Generate with:
#   openssl rand -base64 24 | tr -d '/+=\n'
POSTGRES_PASSWORD=

# Seals the signing keys, webhook keys and second-factor secrets stored in the database. Losing it
# makes them unreadable. Generate once with:
#   openssl rand -base64 32 | tr '+/' '-_'
SECRETS_ENCRYPTION_KEY=

# Signs pagination cursors; keep it stable so cursors survive a restart. Generate with:
#   openssl rand -base64 32
RDM_CURSOR_SIGNING_KEY=

# HTTPS at the web container with the organisation's certificate and key in ./certs as
# fullchain.pem and privkey.pem (the default, files), or plain HTTP behind a load balancer that ends
# HTTPS (proxy). See docs/OPERATIONS.md, Deploying.
#WEB_TLS=files

# With WEB_TLS=proxy: the address or range the load balancer connects from, comma-separated (for
# example 10.0.0.0/8,192.168.1.5). Only from these does web believe X-Forwarded-For. Empty (the
# default) trusts nobody: every caller then appears as the load balancer, and the sign-in throttle
# counts them as one address. List the balancer's range. docs/OPERATIONS.md, Deploying.
#WEB_TRUSTED_PROXIES=

# The folder holding fullchain.pem and privkey.pem (default ./certs, beside compose.yml).
#WEB_CERTS_DIR=./certs

# The ports published on this host for HTTP (redirected to PUBLIC_URL) and HTTPS.
#WEB_HTTP_PORT=80
#WEB_HTTPS_PORT=443

# The largest request body web accepts (default 256m). The engine's own limits, for example
# IMPORT_MAX_BYTES, apply behind it.
#WEB_MAX_BODY=256m

# ===== Every other engine setting =====
# Generated from the engine's settings catalogue: python -m app.cli.settings_template --for compose
# (run from backend/; a unit test fails while this part differs). compose.yml passes every value set
# in .env to the engine, so remove the # in front of a setting to set it; each is described in
# docs/OPERATIONS.md, Settings. Not here because compose.yml or the image sets them: DATABASE_URL,
# CORS_ORIGINS (from PUBLIC_URL), RDM_MODEL_PATH and JOB_FILE_DIR. Retired settings
# (INFERENCE_ASSISTANT, INFERENCE_ASSISTANT_ROWS, CONSUMER_WEBHOOK_KEY_ENCRYPTION_KEY) make the
# engine refuse to start.

# --- Runtime

# Where the source of the running version is offered to its users; the project's tag of this
# version unless set (AGPL section 13).
#SOURCE_CODE_URL=
# Where the API reference page at /docs loads its script from: bundled or cdn.
#RDM_API_REFERENCE_SCRIPT=bundled
# Server worker processes on this instance.
#WEB_CONCURRENCY=1
# Database connections each process keeps open.
#DATABASE_POOL_SIZE=5
# Database connections each process opens beyond the pool size when busy.
#DATABASE_POOL_MAX_OVERFLOW=10
# Seconds a request waits for a database connection before it answers 503.
#DATABASE_POOL_TIMEOUT=30
# Seconds a connection may sit idle inside a transaction before the database ends it, releasing a
# stalled process's locks; 0 turns it off.
#DATABASE_IDLE_TRANSACTION_TIMEOUT=300
# How the log is written: text lines, or one JSON object a line.
#LOG_FORMAT=text
# The lowest level the log writes.
#LOG_LEVEL=INFO
# Seconds between each process's reports of its state to the others.
#PROCESS_HEARTBEAT_SECONDS=15
# Minutes an access token lasts, for people and clients.
#ACCESS_TOKEN_MINUTES=60
# Days a token signing key signs before the next token brings a new one.
#TOKEN_SIGNING_KEY_DAYS=30
# Hours a browser session lasts without being used.
#SESSION_IDLE_HOURS=12
# Days a browser session lasts in all before the person signs in again.
#SESSION_DAYS=14
# Hours a password-reset link stays valid.
#PASSWORD_RESET_HOURS=24
# Characters a local password needs at least; lower only for development.
#PASSWORD_MIN_LENGTH=15
# The command that starts the assistant's Claude Code session, for example: claude --model sonnet;
# empty, the assistant runs no session.
#AI_AGENT_COMMAND=
# container when the engine runs in a container, where Claude Code's own sandbox cannot run;
# empty, the operating system's sandbox.
#AI_AGENT_SANDBOX=
# The API address the assistant's session uses; empty, this instance's own.
#AI_AGENT_API_URL=

# --- Capability groups: what the engine serves

# Model drafts, compiling, installing and activating releases.
#MODEL_ADMIN_MUTATIONS_ENABLED=false
# Creating, renaming, retiring, deleting workspaces and choosing the default.
#WORKSPACE_ADMIN_MUTATIONS_ENABLED=true
# Creating and cancelling jobs (POST /batches); job reads stay available.
#INTEGRATION_JOBS_ENABLED=true
# Webhook subscriptions and their delivery.
#CONSUMER_SUBSCRIPTIONS_ENABLED=false

# --- Batch and job limits

# Items in an inline batch.
#BATCH_MAX_ITEMS=1000
# Bytes in an inline batch's body.
#BATCH_MAX_BYTES=5242880
# Items in an atomic batch, inline or background.
#ATOMIC_JOB_MAX_ITEMS=10000
# Items in a background batch.
#BACKGROUND_JOB_MAX_ITEMS=1000000
# Bytes in a background batch's body.
#BATCH_BACKGROUND_MAX_BYTES=52428800
# Items one background chunk commits.
#JOB_CHUNK_ITEMS=500
# Bytes in an import's file.
#IMPORT_MAX_BYTES=209715200
# Items a preview of an import or a batch runs before it is a sample.
#JOB_PREVIEW_MAX_ITEMS=10000
# Operations in one request to a model draft.
#MODEL_OPERATION_MAX_ITEMS=500
# Seconds a worker holds a job, renewed with each chunk.
#JOB_LEASE_SECONDS=120
# Days a finished job keeps its outcomes and idempotency key.
#JOB_RETENTION_DAYS=7
# Days the change feed and consumer events answer a position.
#FEED_RETENTION_DAYS=30
# Items in one consumer batch resolve.
#CONSUMER_RESOLVE_MAX_ITEMS=1000

# --- Webhook subscriptions

# Days the webhook delivery log keeps a request, its body and its attempts.
#CONSUMER_WEBHOOK_LOG_RETENTION_DAYS=7

# --- AI proposals: off unless AI_PROVIDER is set (OPERATIONS § AI proposals)

# The proposal provider: claude, openai-compatible or a factory module:function; empty, the
# default, sends nothing anywhere.
#AI_PROVIDER=
# The provider's model; empty for claude means claude-opus-5-5.
#AI_MODEL=
# The provider's key; never shown. Secret: never shown, keep it out of images and logs.
#AI_API_KEY=
# The provider's address: required for openai-compatible, empty for Claude's own.
#AI_BASE_URL=
# The most that may leave the instance: structure (no values), samples (a few) or values (as many
# as a feature needs).
#AI_SEND_LEVEL=values
# At send level samples, the most values per column, or rows per sheet, that are sent.
#AI_SAMPLE_VALUES=20
# The confidence, 0 to 1, below which a proposal is not offered.
#AI_MIN_CONFIDENCE=0.5
# Keep each call's request and answer for an operator debugging a prompt.
#AI_LOG_CONTENT=false
# Days a call's kept request and answer stay, when AI_LOG_CONTENT is on.
#AI_LOG_CONTENT_DAYS=7
# Seconds one call to the provider may take before it fails.
#AI_TIMEOUT_SECONDS=60
# openai-compatible only: how much the model reasons first, none, low, medium or high; empty sends
# nothing. none keeps a local thinking model fast.
#AI_REASONING_EFFORT=
# The model's context window in tokens, for a small local model; each call is sized to half of it.
# Empty: no limit.
#AI_CONTEXT_TOKENS=
# The most calls to the provider one job of an assistant task may make; reached, the task keeps
# what the rules read and the assistant had proposed, with a warning.
#AI_MAX_STEPS=40
# Days an assistant task is kept after it finished (loaded, failed or cancelled) or was last
# changed; then it and its file are deleted.
#AI_TASK_RETENTION_DAYS=90
# Whether assistants can reach the instance at /mcp; off, the endpoint does not exist.
#MCP_ENABLED=false
# Tool calls one person or client may make through /mcp in a minute.
#MCP_RATE_PER_MINUTE=120
# Whether an assistant may register itself; off, only those an administrator registers can sign
# people in.
#MCP_OPEN_REGISTRATION=true
# HTTPS hosts a self-registered assistant may return to, besides this computer.
#MCP_REDIRECT_HOSTS=
# Days a record of a tool call through /mcp is kept.
#MCP_CALLS_DAYS=90
