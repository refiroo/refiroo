{
  "name": "rdm-engine-ui",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "node e2e/wp9-navigation.mjs",
    "test:browser:authoring": "node e2e/wp9-authoring.mjs",
    "test:browser:drafts": "node e2e/wp9-drafts.mjs",
    "test:browser:history": "node e2e/wp9-history.mjs",
    "test:browser:wp11": "node e2e/wp11-model-admin.mjs",
    "test:browser:wp14": "node e2e/wp14-contextual-browser.mjs",
    "test:gate-helpers": "node --test e2e/helpers/*.node-test.mjs",
    "test:a11y": "node e2e/accessibility-gate.mjs",
    "test:visual": "node e2e/visual-regression-gate.mjs",
    "test:visual:update": "node e2e/visual-regression-gate.mjs --update-baselines"
  },
  "dependencies": {
    "lucide-react": "1.39.0",
    "react": "^19.2.8",
    "react-aria-components": "1.21.0",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "playwright": "1.56.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
