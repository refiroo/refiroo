# Headers every response carries; included in each location, since add_header in a location
# replaces the ones above it.
add_header Strict-Transport-Security "max-age=31536000" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "same-origin" always;
# No page of this origin may be shown inside another site's frame (clickjacking); the older header
# covers browsers that ignore frame-ancestors. The Content-Security-Policy is set per location: the
# application's own in csp-app.inc, and for what the engine answers frame-ancestors alone in
# locations.inc, since the engine sends the policy of its sign-in pages, the guide and the API
# reference itself, and a second, stricter policy here would apply on top of it.
add_header X-Frame-Options "DENY" always;
