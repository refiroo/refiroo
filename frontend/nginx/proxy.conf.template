# Plain HTTP behind a load balancer that ends HTTPS (WEB_TLS=proxy, 0.12 DP2, D407).
# The caller is the address this container is connected from, unless that address is listed in
# WEB_TRUSTED_PROXIES (the load balancer's own range): then X-Forwarded-For names the caller (the real_ip
# module, 05-choose-mode.sh). The engine is sent that one address, whatever the request carried. The
# load balancer's scheme (X-Forwarded-Proto) passes on. Keep this container reachable only from it.
map $scheme $forwarded_for { default $remote_addr; }
map $http_x_forwarded_proto $forwarded_proto { default $scheme; https https; }

include /etc/nginx/conf.d/snippets/real-ip.inc;

gzip on;
gzip_types text/css application/javascript application/json image/svg+xml;
client_max_body_size ${WEB_MAX_BODY};

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    location = /web-health {
        access_log off;
        return 200 "ok\n";
    }

    include /etc/nginx/conf.d/snippets/locations.inc;
}
